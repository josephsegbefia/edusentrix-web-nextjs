# Copy to `.env.local` and fill in values. This file lists email-related variables
# used by the codebase (Brevo, Spacemail, webhooks, crons, templates).

# =============================================================================
# Email — Brevo transactional client (src/lib/email/brevo.ts)
# =============================================================================
BREVO_API_KEY="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"
BREVO_FROM_EMAIL=hello@tryedusentrix.app
BREVO_FROM_NAME=Edusentrix
EMAIL_AUDIT_ENABLED=true

# =============================================================================
# Email — Brevo provider / send API (src/lib/email/providers/brevo-provider.ts)
# =============================================================================
BREVO_DEFAULT_FROM_EMAIL=hello@tryedusentrix.app
BREVO_DEFAULT_FROM_NAME=Edusentrix
BREVO_BILLING_FROM_EMAIL=billing@tryedusentrix.app

# =============================================================================
# Email — HTML templates & asset URLs (src/lib/email/templates.ts)
# =============================================================================
APP_URL=

# =============================================================================
# Email — Inbound reply routing (src/lib/email/routing.ts)
# =============================================================================
EMAIL_REPLY_DOMAIN=reply.tryedusentrix.app

# =============================================================================
# Email — Spacemail SMTP — manual / human support sends (src/lib/email/providers/spaceship-provider.ts, send-manual-support-email.ts)
# =============================================================================
SPACEMAIL_SMTP_HOST=mail.spaceship.com # or your own SMTP host
SPACEMAIL_SMTP_PORT=587 # or your own SMTP port 
SPACEMAIL_SMTP_USER=support@tryedusentrix.app  # or your own SMTP user
SPACEMAIL_SMTP_PASSWORD=Fingerzz20! # or your own SMTP password

# =============================================================================
# Email — Spacemail IMAP — recovery sync (src/lib/email/providers/imap-client.ts, src/lib/jobs/imapRecoverySync.ts)
# =============================================================================
SPACEMAIL_IMAP_HOST=mail.spaceship.com # or your own IMAP host 
SPACEMAIL_IMAP_PORT=993 # or your own IMAP port
SPACEMAIL_IMAP_USER=support@tryedusentrix.app # or your own IMAP user
SPACEMAIL_IMAP_PASSWORD=Fingerzz20! # or your own IMAP password

# =============================================================================
# Email — Brevo webhooks (src/app/api/webhooks/brevo/route.ts, brevo-inbound/route.ts)
# BREVO_WEBHOOK_SECRET: For outbound webhooks, generate a long random token (e.g. openssl rand -hex 32),
# paste the same value in Brevo "Token authentication" and here. Requests must send Authorization: Bearer <token>.
# If Brevo sends x-brevo-signature (legacy transactional HMAC), use the signing key Brevo gives for that flow instead.
# =============================================================================
BREVO_WEBHOOK_SECRET=36d172c216e1e436a0f3b2e9ec467466916f64158b1431c379d43a1505e3d6c1
BREVO_INBOUND_PARSE_WEBHOOK_SECRET=c9619cf8ae3a53eb45d571e17536b8c25bbb0338908abeb6c399188899d62378

# =============================================================================
# Email — Cron jobs (src/app/api/cron/email-dispatch/route.ts, imap-recovery/route.ts)
# =============================================================================
EMAIL_DISPATCH_CRON_SECRET=d5c50f6b3ce5fda8c52c3646602588e8aed8b8caf765b5b8b21e4f66ae4478f9
IMAP_RECOVERY_CRON_SECRET=0e792e92a340631217806bfa1a7f7ae7adbbb442502294be264f76c42ed597c9

# =============================================================================
# Email — Platform settings UI (src/app/(app)/platform/settings/page.tsx)
# =============================================================================
SUPPORT_EMAIL=support@tryedusentrix.app

# =============================================================================
# Meetings / LiveKit — in-app video meetings
# =============================================================================
# Base HTTPS URL for the LiveKit server API, e.g. https://your-project.livekit.cloud
LIVEKIT_URL=
# Optional websocket URL for clients. If omitted, the app derives it from LIVEKIT_URL.
LIVEKIT_WS_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional scheduling defaults
LIVEKIT_MEETING_EMPTY_TIMEOUT_SECONDS=600
LIVEKIT_MEETING_MAX_PARTICIPANTS=32
LIVEKIT_JOIN_TOKEN_TTL_SECONDS=3600
