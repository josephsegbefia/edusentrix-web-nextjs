# Copy to `.env.local` and fill in values. This file lists email-related variables
# used by the codebase (Resend, Spacemail, webhooks, crons, templates).

# =============================================================================
# Email — Resend transactional delivery
# =============================================================================
RESEND_API_KEY=
RESEND_DEFAULT_FROM_EMAIL=hello@tryedusentrix.app
RESEND_DEFAULT_FROM_NAME=EduSentrix
RESEND_BILLING_FROM_EMAIL=billing@tryedusentrix.app
RESEND_SUPPORT_FROM_EMAIL=support@tryedusentrix.app
EMAIL_AUDIT_ENABLED=true

# =============================================================================
# Email — HTML templates & asset URLs (src/lib/email/templates.ts)
# =============================================================================
APP_URL=

# =============================================================================
# Email — Inbound reply routing (src/lib/email/routing.ts)
# =============================================================================
EMAIL_REPLY_DOMAIN=reply.tryedusentrix.app

# =============================================================================
# Email — Spacemail SMTP — manual / human support sends (src/lib/email/providers/spaceship-provider.ts, send-manual-support-email.ts)
# =============================================================================
SPACEMAIL_SMTP_HOST=mail.spaceship.com # or your own SMTP host
SPACEMAIL_SMTP_PORT=587 # or your own SMTP port 
SPACEMAIL_SMTP_USER=support@tryedusentrix.app  # or your own SMTP user
SPACEMAIL_SMTP_PASSWORD=

# =============================================================================
# Email — Spacemail IMAP — primary inbound (hello / support / billing mailboxes)
# See docs/PLATFORM_EMAIL_EXTERNAL_SETUP.md
# =============================================================================
# Must be mail.spacemail.com (mail.spaceship.com does not resolve)
SPACEMAIL_IMAP_HOST=mail.spacemail.com
EMAIL_SYNC_ENABLED=true

# Per-mailbox IMAP (recommended). Legacy SPACEMAIL_IMAP_USER/PASSWORD = support fallback.
SPACEMAIL_HELLO_IMAP_USER=hello@tryedusentrix.app
SPACEMAIL_HELLO_IMAP_PASSWORD=
SPACEMAIL_SUPPORT_IMAP_USER=support@tryedusentrix.app
SPACEMAIL_SUPPORT_IMAP_PASSWORD=
SPACEMAIL_BILLING_IMAP_USER=billing@tryedusentrix.app
SPACEMAIL_BILLING_IMAP_PASSWORD=

# Legacy support-only fallback
SPACEMAIL_IMAP_PORT=993
SPACEMAIL_IMAP_USER=support@tryedusentrix.app
SPACEMAIL_IMAP_PASSWORD=

PLATFORM_HELLO_EMAIL=hello@tryedusentrix.app
PLATFORM_SUPPORT_EMAIL=support@tryedusentrix.app
PLATFORM_BILLING_EMAIL=billing@tryedusentrix.app
PLATFORM_GROWTH_ADMIN_EMAIL=

# =============================================================================
# =============================================================================
# Email — Cron jobs (src/app/api/cron/email-dispatch/route.ts, imap-recovery/route.ts)
# =============================================================================
EMAIL_DISPATCH_CRON_SECRET=
IMAP_RECOVERY_CRON_SECRET=
# Shared fallback for Vercel Cron Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
# Subscription renewal notices and scheduled plan changes. Falls back to CRON_SECRET.
SUBSCRIPTION_CRON_SECRET=

# =============================================================================
# Email — Platform settings UI (src/app/(app)/platform/settings/page.tsx)
# =============================================================================
SUPPORT_EMAIL=support@tryedusentrix.app

# =============================================================================
# Meetings / LiveKit — in-app video meetings
# =============================================================================
# Base HTTPS URL for the LiveKit server API, e.g. https://your-project.livekit.cloud
LIVEKIT_URL=
# Optional websocket URL for clients. If omitted, the app derives it from LIVEKIT_URL.
LIVEKIT_WS_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional scheduling defaults
LIVEKIT_MEETING_EMPTY_TIMEOUT_SECONDS=600
LIVEKIT_MEETING_MAX_PARTICIPANTS=32
LIVEKIT_JOIN_TOKEN_TTL_SECONDS=3600

# =============================================================================
# Demo runtime — demo.tryedusentrix.app
# =============================================================================
DEMO_BASE_URL=https://demo.tryedusentrix.app
DEMO_SESSION_SECRET=
DEMO_DEFAULT_SESSION_MINUTES=90
DEMO_IDLE_TIMEOUT_MINUTES=5
DEMO_MAX_ACTIVE_SESSIONS=50
# Optional: when the main platform app and demo app run on different MongoDBs,
# point the main app at the demo database for `/platform/demo-leads`.
DEMO_DATA_MONGODB_URI=
DEMO_DATA_MONGO_DB_NAME=

# =============================================================================
# Platform admin bootstrap — secret URL + email OTP (src/app/(public)/platform-bootstrap)
# =============================================================================
# Long random path segment (min 24 chars). URL: /platform-bootstrap/<PLATFORM_ADMIN_BOOTSTRAP_SECRET>
PLATFORM_ADMIN_BOOTSTRAP_SECRET=
# Inbox that receives the 6-digit gate code before the creation form unlocks
PLATFORM_BOOTSTRAP_NOTIFY_EMAIL=elsegbefia@gmail.com
# Optional: pepper for hashing URL token in DB (defaults to built-in v1 string if unset)
# PLATFORM_BOOTSTRAP_KEY_PEPPER=
# Set to "true" only for emergency recovery when a platform admin already exists
# PLATFORM_BOOTSTRAP_ALLOW_WHEN_ADMINS_EXIST=false

# =============================================================================
# E2E teacher login bypass — local/dev testing only
# =============================================================================
# When true outside production, teacher creation creates/updates a Clerk login
# directly and shows a temporary password instead of sending an invite email.
E2E_TEACHER_LOGIN_BYPASS_ENABLED=false
E2E_TEACHER_DEFAULT_PASSWORD=TeacherTest123!

# =============================================================================
# Payments — Paystack (src/lib/paystack.ts, src/app/api/webhooks/paystack/route.ts)
# Used for school fee invoices, store orders, donations, subscriptions, and
# the Admissions application fee (Phase 5).
# =============================================================================
# Server-side secret key from Paystack dashboard (sk_test_... or sk_live_...).
PAYSTACK_SECRET_KEY=
# Optional public key, only needed for Paystack inline JS in the browser.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# =============================================================================
# Admissions — weekly digest cron (src/app/api/cron/admissions-weekly-digest/route.ts)
# =============================================================================
ADMISSIONS_DIGEST_CRON_SECRET=

# =============================================================================
# Library — cron jobs (reservation expiry + overdue loans; same secret)
# GET/POST /api/cron/library-reservation-expiry
# GET/POST /api/cron/library-loans-overdue
# Falls back to CRON_SECRET when unset.
# =============================================================================
# LIBRARY_CRON_SECRET=

# =============================================================================
# Leo Copilot — runtime kill switches (src/lib/leo/runtime.ts, LEO_COPILOT_ROADMAP.md)
# =============================================================================
# Server: APIs return 503 when not "true". Client: floating "Ask Leo" stays hidden when not "true".
FEATURE_LEO_COPILOT_RUNTIME_ENABLED=false
NEXT_PUBLIC_FEATURE_LEO_COPILOT_RUNTIME_ENABLED=false

# =============================================================================
# Internal test school mode (platform admin only; src/lib/internal-test/*)
# ENABLE_INTERNAL_TEST_TOOLS: server gate for all /api/platform/schools/.../internal-test/* routes.
# INTERNAL_TEST_ACTIVATION_SECRET: required for activate/disable; never expose to the client.
# INTERNAL_TEST_IMPERSONATION_SECRET: optional HMAC secret for View-as cookie tokens; falls back to
# INTERNAL_TEST_ACTIVATION_SECRET when unset (see src/lib/internal-test/impersonation-secret.ts).
# Optional: list capability keys on platform admin User documents, e.g. platform.internalTest.manage
# =============================================================================
# ENABLE_INTERNAL_TEST_TOOLS=false
# INTERNAL_TEST_ACTIVATION_SECRET=
# INTERNAL_TEST_IMPERSONATION_SECRET=
